      "category": "team_form",
      "leakage_safe": true,
      "introduced_version": "10.0.0"
    },
    "defense_round_win_rate": {
      "source": "round_history",
      "formula": "defense_round_wins / total_defense_rounds",
      "category": "team_form",
      "leakage_safe": true,
      "introduced_version": "10.0.0"
    },
    "first_half_win_rate": {
      "source": "round_history",
      "formula": "rounds_1_to_12_wins / total_first_half_rounds",
      "category": "team_form",
      "leakage_safe": true,
      "introduced_version": "10.0.0"
