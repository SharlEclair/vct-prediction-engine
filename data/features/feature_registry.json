{
  "version": "10.0.0",
  "last_updated": "2026-08-07",
  "features": {
    "matches_played": {
      "source": "historical_matches",
      "formula": "count(matches_prior_to_date)",
      "category": "team_form",
      "leakage_safe": true,
      "introduced_version": "10.0.0"
    },
    "win_rate": {
      "source": "historical_matches",
      "formula": "wins / total_matches",
      "category": "team_form",
      "leakage_safe": true,
      "introduced_version": "10.0.0"
    },
    "full_buy_win_rate": {
      "source": "match_economy",
      "formula": "full_buy_wins / total_full_buy_rounds",
      "category": "economy",
      "leakage_safe": true,
      "introduced_version": "10.0.0"
    },
    "semi_buy_win_rate": {
      "source": "match_economy",
      "formula": "semi_buy_wins / total_semi_buy_rounds",
      "category": "economy",
      "leakage_safe": true,
      "introduced_version": "10.0.0"
    },
    "eco_conversion": {
      "source": "match_economy",
      "formula": "eco_wins / total_eco_rounds",
      "category": "economy",
      "leakage_safe": true,
      "introduced_version": "10.0.0"
    },
    "pistol_win_rate": {
      "source": "match_economy",
      "formula": "pistol_wins / total_pistol_rounds",
      "category": "economy",
      "leakage_safe": true,
      "introduced_version": "10.0.0"
    },
    "attack_round_win_rate": {
      "source": "round_history",
