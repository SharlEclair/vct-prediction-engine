      "category": "combat_performance",
      "leakage_safe": true,
      "introduced_version": "10.0.0"
    },
    "KAST_EMA": {
      "source": "player_history",
      "formula": "exponential_moving_average(kast_percentage, alpha=0.2)",
      "category": "combat_performance",
      "leakage_safe": true,
      "introduced_version": "10.0.0"
    },
    "ADR_EMA": {
      "source": "player_history",
